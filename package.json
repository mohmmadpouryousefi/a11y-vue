{
  "name": "@mohammadpy/a11y-vue",
  "version": "0.0.0",
  "description": "A small, typed, accessible Vue 3 component library: modal, combobox, tabs, toast, data table.",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "accessibility",
    "a11y",
    "wai-aria",
    "typescript"
  ],
  "license": "MIT",
  "author": "Mohammadtaghi Pouryousefi Koudehi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohmmadpouryousefi/a11y-vue.git"
  },
  "homepage": "https://github.com/mohmmadpouryousefi/a11y-vue#readme",
  "bugs": "https://github.com/mohmmadpouryousefi/a11y-vue/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm typecheck && vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.18.0"
}
